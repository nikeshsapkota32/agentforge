# OpenAI
OPENAI_API_KEY=sk-...

# Pinecone
PINECONE_API_KEY=...
PINECONE_INDEX=agentforge-memory

# LangSmith
LANGSMITH_API_KEY=...
LANGSMITH_PROJECT=agentforge

# PostgreSQL
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=changeme
POSTGRES_DB=agentforge
DATABASE_URL=postgresql://agentforge:changeme@postgres:5432/agentforge

# Redis
REDIS_URL=redis://redis:6379

# JWT (generate: openssl genrsa -out private.pem 2048)
JWT_PRIVATE_KEY_PATH=./certs/private.pem
JWT_PUBLIC_KEY_PATH=./certs/public.pem
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
