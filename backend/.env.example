ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentforge
DATABASE_ECHO=false

REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=10

CORS_ORIGINS=["http://localhost:3000"]

JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
# Or paste PEMs directly (useful on Render/Fly/etc):
# JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# LLM provider — pick one.
# Default (paid): OpenAI GPT-4o
# Free: Groq Llama 3.3 70B (set LLM_PROVIDER=groq, paste your Groq key into LLM_API_KEY)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Legacy / fallback (still read if LLM_* are blank).
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Embeddings — leave OPENAI_API_KEY set to enable, or:
EMBEDDINGS_PROVIDER=openai   # set to "disabled" on the free stack
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=

PINECONE_API_KEY=
PINECONE_INDEX=agentforge

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentforge
LANGSMITH_TRACING=false

SERPAPI_API_KEY=

MAX_CRITIC_LOOPS=2
MIN_PASSING_SCORE=7
